# Variáveis do PokeWeed. Nenhuma é obrigatória — o app sobe sem nada disso.
# Numa hospedagem, configure elas no painel do serviço (não suba um .env real
# pro repositório).

# Porta do servidor (a maioria das hospedagens define isso sozinha).
PORT=8080

# ONDE FICAM OS DADOS — a variável mais importante numa hospedagem.
# Aponte pro disco persistente do serviço (no Railway, o caminho onde você
# montou o Volume), senão contas, fotos e vídeos somem a cada deploy.
# DATA_DIR=/dados

# Nome antigo da mesma variável — ainda funciona, é o que o render.yaml usa:
# POKEWEED_DATA=/dados

# Se quiser separar banco e arquivos em lugares diferentes:
# DB_FILE=/dados/pokeweed.db
# MEDIA_DIR=/dados/midia

# Limites de envio. Aumente se sua hospedagem tem disco sobrando.
MAX_IMAGE_MB=4
MAX_VIDEO_MB=40

# Só pra testar no celular em casa: sobe com certificado autoassinado,
# porque a câmera do navegador exige HTTPS. Em produção deixe desligado —
# a hospedagem já põe HTTPS na frente.
# HTTPS=1
